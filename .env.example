# Database Configuration
#DATABASE_URL=postgresql://username:password@localhost:5432/mcptools
DATABASE_URL=sqlite:///./mcptools.db

# Application Configuration
APP_NAME=singularitynear.com
APP_VERSION=0.1.0

# Environment (development, production, testing)
ENVIRONMENT=development

# Debug mode (set to False in production)
DEBUG=False

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (for development, use *; for production, specify domains)
CORS_ORIGINS=*
# Public wildcard access never enables cookies. Management defaults to same-origin;
# MCP/server-to-server calls do not require CORS. Separate origins with commas.
SITE_ADMIN_CORS_ORIGINS=

# Logging
LOG_LEVEL=INFO

# Website management: two DIFFERENT random tokens, at least 32 characters each.
# Empty tokens disable the management API. Never place tokens in a page or URL.
SITE_ADMIN_TOKEN=
SITE_ANALYTICS_TOKEN=
